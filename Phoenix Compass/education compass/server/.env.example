NODE_ENV=development
PORT=3000
DATABASE_URL=
SESSION_SECRET=replace-with-at-least-32-random-characters
PAYMENT_PROVIDER=mock
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MCH_ID=
WECHAT_MCH_CERT_SERIAL_NO=
WECHAT_MCH_PRIVATE_KEY_PATH=
WECHATPAY_API_V3_KEY=
WECHATPAY_PUBLIC_KEY_ID=
WECHATPAY_PUBLIC_KEY_PATH=
WECHAT_PAY_NOTIFY_URL=https://api.example.com/v1/webhooks/wechat-pay/transactions
WECHAT_REFUND_NOTIFY_URL=https://api.example.com/v1/webhooks/wechat-pay/refunds
PUBLIC_BASE_URL=https://api.example.com
PAID_COMPASS_ENABLED=false
GROWTH_DISCOVERY_PAYMENT_ENABLED=false
SOURCE_CATALOG_MODE=placeholder
SOURCE_CATALOG_PATH=

# Canonical FD-6 OIDC/JWT validation. Keep disabled until a Founder-approved
# broker, exact public metadata and separate app/binder credential references
# exist. These fields contain no signing key or client secret.
CANONICAL_OIDC_ENABLED=false
CANONICAL_OIDC_ISSUER=
CANONICAL_OIDC_AUDIENCE=phoenix-canonical-postgresql
CANONICAL_OIDC_JWKS_URI=
CANONICAL_OIDC_ALLOWED_ALGORITHMS=ES256
CANONICAL_OIDC_TOKEN_MAX_TTL_SECONDS=300
CANONICAL_OIDC_CLOCK_SKEW_SECONDS=60
CANONICAL_OIDC_JWKS_CACHE_SECONDS=300
CANONICAL_OIDC_UNKNOWN_KID_REFRESH_RATE_LIMIT_SECONDS=60

# Founder-selected first-party Canonical identity broker. It stays disabled until
# PUBLIC_BASE_URL is the approved HTTPS origin and the protected files exist.
CANONICAL_OIDC_BROKER_ENABLED=false
CANONICAL_OIDC_BROKER_KEY_ID=phoenix-canonical-es256-v1
CANONICAL_OIDC_BROKER_TOKEN_TTL_SECONDS=300
CANONICAL_OIDC_BROKER_SIGNING_KEY_FILE=/run/secrets/phoenix_canonical_oidc_signing_key_v1
CANONICAL_OIDC_BROKER_SIGNING_KEY_REF=file:/run/secrets/phoenix_canonical_oidc_signing_key_v1
CANONICAL_POSTGRES_APP_CREDENTIAL_REF=file:/run/secrets/phoenix_canonical_app_pgpass_v1
CANONICAL_POSTGRES_BINDER_CREDENTIAL_REF=file:/run/secrets/phoenix_canonical_binder_pgpass_v1

# Feishu Bitable is an optional, redacted operations mirror. It is never the
# authority for payment, refund, entitlement, questionnaire answers or reports.
FEISHU_BITABLE_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
# Dedicated 32+ byte secret used only to create stable anonymous Feishu IDs.
# Do not reuse SESSION_SECRET. Rotating it requires a mapping migration.
FEISHU_PSEUDONYM_KEY=
# Explicit opt-in for the exact family/student profile allowlist documented in
# docs/FEISHU_BITABLE_SETUP.md. Keep false until privacy approval, Bitable
# access controls and retention/deletion procedures are in place.
FEISHU_CUSTOMER_PROFILE_FIELDS_ENABLED=false
FEISHU_BITABLE_TABLE_FAMILY_PROFILE=
FEISHU_BITABLE_TABLE_STUDENT_PROFILE=
FEISHU_BITABLE_TABLE_ASSESSMENT_SESSION=
FEISHU_BITABLE_TABLE_REPORT_JOB=
FEISHU_BITABLE_TABLE_ORDER_PAYMENT=
FEISHU_BITABLE_TABLE_FEEDBACK=
FEISHU_BITABLE_TABLE_ADVISOR_REQUEST=
FEISHU_SYNC_INTERVAL_MS=60000
FEISHU_SYNC_BATCH_SIZE=50

# Education Compass paid-report follow-up Agent. Keep API and worker flags
# independent; the HTTP process never starts the Agent worker.
OPENAI_AGENT_ENABLED=false
AGENT_PROVIDER=mock
OPENAI_API_KEY=
# Set explicit deployed model IDs for the OpenAI provider; do not use a moving
# alias in production.
OPENAI_MODEL=
OPENAI_MODERATION_MODEL=
OPENAI_REQUEST_TIMEOUT_MS=30000
OPENAI_MAX_OUTPUT_TOKENS=1200
# Dedicated 32+ byte HMAC key. Do not reuse any session, Feishu or content key.
OPENAI_SAFETY_HMAC_KEY=
# JSON object whose values are canonical Base64 encodings of independent
# 32-byte AES keys, for example populated only in the deployment secret store.
AI_CONTENT_KEYRING_JSON={}
AI_CONTENT_CURRENT_KEY_VERSION=v1
AI_CONVERSATION_RETENTION_DAYS=30
AI_WORKER_INTERVAL_MS=1000
AI_WORKER_BATCH_SIZE=5
AI_WORKER_LEASE_MS=60000
AI_WORKER_ENABLED=false
AI_MAX_TURNS_PER_REPORT=3
AI_MAX_MESSAGE_CHARS=2000
AI_RATE_LIMIT_MESSAGES_PER_MINUTE=6
AI_MAX_ACTIVE_RUNS_PER_USER=2
