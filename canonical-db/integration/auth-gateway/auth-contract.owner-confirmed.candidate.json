{
  "contract_version": "1.0",
  "environment": "tencent_isolated_nonproduction",
  "governance": {
    "auth_contract_path": "canonical-db/integration/auth-gateway/AUTH_GATEWAY_INTEGRATION_CONTRACT_V1.0.md",
    "auth_contract_version": "1.0"
  },
  "identity_provider": {
    "provider_name": "Phoenix First-Party Canonical Identity Broker V1.0",
    "issuer": "https://api.phoenixnova.com.cn/canonical-identity",
    "audience": "phoenix-canonical-postgresql",
    "jwks_uri": "https://api.phoenixnova.com.cn/.well-known/phoenix-canonical-jwks.json",
    "signing_key_ref": "file:/run/secrets/phoenix_canonical_oidc_signing_key_v1",
    "required_claims": [
      "iss",
      "aud",
      "exp",
      "nbf",
      "sub"
    ],
    "allowed_algorithms": [
      "ES256"
    ],
    "token_max_ttl_seconds": 300,
    "clock_skew_seconds": 60,
    "jwks_cache_seconds": 300,
    "unknown_kid_refresh_once": true,
    "refresh_rate_limit_seconds": 60
  },
  "identity_mapping": {
    "lookup_key": [
      "issuer",
      "subject"
    ],
    "auto_provision": false,
    "missing_or_disabled_action": "deny"
  },
  "database": {
    "binder_role": "phoenix_canonical_context_binder",
    "app_role": "phoenix_canonical_app",
    "binder_credential_ref": "file:/run/secrets/phoenix_canonical_binder_pgpass_v1",
    "app_credential_ref": "file:/run/secrets/phoenix_canonical_app_pgpass_v1",
    "ticket_ttl_seconds": 45,
    "pool_mode": "session",
    "clear_context_on_return": true,
    "discard_connection_on_clear_failure": true,
    "separate_credentials": true
  },
  "logging": {
    "request_nonce_uuid": true,
    "log_token_raw": false,
    "log_personal_data": false,
    "required_fields": [
      "timestamp",
      "request_nonce",
      "issuer",
      "subject_id",
      "channel",
      "decision",
      "reason_code"
    ]
  },
  "ownership": {
    "application_owner": "Founder 方琳媛",
    "binder_owner": "Founder 方琳媛",
    "principal_resolution_owner": "Founder 方琳媛",
    "audit_event_owner": "Founder 方琳媛",
    "incident_response_owner": "Founder 方琳媛"
  }
}
