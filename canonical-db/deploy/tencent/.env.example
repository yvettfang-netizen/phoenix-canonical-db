PHOENIX_DB_NAME=phoenix_canonical_dev
PHOENIX_DB_BOOTSTRAP_PASSWORD=replace_with_64_hex_characters
PHOENIX_DB_MIGRATOR_PASSWORD=replace_with_64_hex_characters
PHOENIX_DB_APP_PASSWORD=replace_with_64_hex_characters
PHOENIX_DB_READER_PASSWORD=replace_with_64_hex_characters
PHOENIX_DB_BINDER_PASSWORD=replace_with_64_hex_characters
PHOENIX_DB_BACKUP_PASSWORD=replace_with_64_hex_characters
# Management SERVICE principal installed by install.sh (D-10). Not secrets; both or neither.
# Label: 1-200 characters from A-Z a-z 0-9 . _ - (no spaces; this file is sourced by bash).
# Example: PHOENIX_DB_SERVICE_PRINCIPAL_ID=018f0000-0000-7000-8000-00000000a001
PHOENIX_DB_SERVICE_PRINCIPAL_ID=
PHOENIX_DB_SERVICE_PRINCIPAL_LABEL=
